{
  // Local history snapshots can contain stale tsconfig options and should not
  // participate in active TypeScript diagnostics for this workspace.
  "files.watcherExclude": {
    "**/.history/**": true
  },
  "search.exclude": {
    "**/.history/**": true
  },
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "**/.history",
      "**/.next",
      "**/.firebase",
      "**/node_modules"
    ]
  },
  // Keep line endings aligned with repository LF policy on Windows saves.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  // Windows cloud instances without dedicated GPU acceleration are generally
  // more stable with software terminal rendering.
  "terminal.integrated.gpuAcceleration": "off"
}
