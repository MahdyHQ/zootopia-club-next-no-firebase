# Zootopia Club environment template.
# Copy this file to .env.local at the repository root and fill real values.
# Never commit real secrets.
#
# Change application:
# - NEXT_PUBLIC_* keys are exposed to browser bundles and also read by server code.
#   Restart local Next after updates and redeploy production for changes to apply everywhere.
# - Server-only keys are not exposed to the browser.
#   Restart local Next after updates and redeploy production.
# - next.config.ts reads origin keys at boot (NEXT_PUBLIC_BASE_URL, NEXTAUTH_URL, VERCEL_URL).
#   Always restart local Next when changing these.

# ============================================================================
# [MIXED] Runtime-crossing keys (server + routing/bootstrap + client surfaces)
# ============================================================================

# Canonical app base URL for server runtime origin resolution and allowed server-action origins.
# Accepted input:
# - Full URL: https://zootopia-club.com
# - Host with optional port: localhost:3000, zootopia-club.com
# Runtime normalization:
# - localhost/127.0.0.1 -> http://...
# - other hosts -> https://...
# Fallback chain when unset/invalid: NEXTAUTH_URL -> VERCEL_URL -> http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional Auth.js base URL fallback in the server origin chain.
NEXTAUTH_URL=

# Usually injected by Vercel. Optional locally.
# VERCEL_URL=

# Supabase public runtime (browser + server helper fallback chain).
# Browser code requires NEXT_PUBLIC_* keys; server code can still fall back to SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy public alias still accepted as fallback for publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth redirect defaults after successful sign-in/bootstrap.
# Values must be internal relative paths. Invalid or out-of-scope values are sanitized to "/".
# User-safe routes: /, /upload, /history, /assessment, /infographic, /settings
# Admin-safe routes: /, /admin, /admin/users
NEXT_PUBLIC_ZOOTOPIA_AUTH_USER_DEFAULT_REDIRECT=/
NEXT_PUBLIC_ZOOTOPIA_AUTH_ADMIN_DEFAULT_REDIRECT=/

# =============================================================================
# [PUBLIC] Browser-safe feature shaping (UI-only; not an authorization boundary)
# =============================================================================

# Assessment Studio UI lock settings for normal users.
# enabled parser:
# - true values: 1, true, yes, on
# - false values: 0, false, no, off
# - invalid/missing -> fallback shown below
# max question count: invalid or <=0 -> 40, hard cap 100
# allowed question types/languages: CSV; invalid entries are dropped; empty -> defaults
NEXT_PUBLIC_ZOOTOPIA_UI_LOCK_ENABLED=true
NEXT_PUBLIC_ZOOTOPIA_UI_LOCK_MAX_QUESTION_COUNT_USER=40
NEXT_PUBLIC_ZOOTOPIA_UI_LOCK_USER_ALLOWED_QUESTION_TYPES=mcq
NEXT_PUBLIC_ZOOTOPIA_UI_LOCK_USER_ALLOWED_OUTPUT_LANGUAGES=en

# Client-side credit diagnostics logging gate.
# true values: 1, true, yes (case-insensitive)
NEXT_PUBLIC_ZOOTOPIA_ASSESSMENT_CREDIT_DIAGNOSTICS=false

# ============================================================
# [SERVER] Server-only authority, secrets, and ops governance
# ============================================================

# Auth.js signing secret (canonical key, required).
# Generate with: npx auth secret
AUTH_SECRET=

# Optional compatibility alias used as fallback by runtime checks and password-gate signing.
NEXTAUTH_SECRET=

# Server-authoritative admin allowlist.
# CSV/newline/semicolon are accepted delimiters. Quotes around the full value are tolerated.
ZOOTOPIA_ADMIN_EMAILS=admin@example.com

# Deprecated legacy admin password gate (not used by current admin auth flow).
# ZOOTOPIA_ADMIN_LOGIN_PASSWORD=

# Supabase server runtime (required for durable auth/profile writes and admin operations).
# SUPABASE_URL can mirror NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Durable Postgres adapter runtime.
# Preferred: Supabase transaction pooler URL (port 6543, pgbouncer=true).
# Fallback chain: SUPABASE_DATABASE_URL -> DATABASE_URL
SUPABASE_DATABASE_URL=
# DATABASE_URL=

# Production durability override.
# When false/missing in production, durable persistence is required (fail-closed if missing).
# true values: 1, true, yes
ZOOTOPIA_ALLOW_PRODUCTION_MEMORY_FALLBACK=false

# ----------------------------
# Auth admission governance
# ----------------------------
# mode: enforce | disabled (default enforce)
# window seconds: default 900, clamped to 60..86400
# attempt limits: clamped to 1..500
# Keep hash salt stable after first rollout for deterministic account/IP buckets.
ZOOTOPIA_AUTH_ADMISSION_MODE=enforce
ZOOTOPIA_AUTH_ADMISSION_WINDOW_SECONDS=900
ZOOTOPIA_AUTH_ADMISSION_HASH_SALT=
ZOOTOPIA_AUTH_SIGNIN_ACCOUNT_MAX_ATTEMPTS=12
ZOOTOPIA_AUTH_SIGNIN_IP_MAX_ATTEMPTS=60
ZOOTOPIA_AUTH_SIGNUP_ACCOUNT_MAX_ATTEMPTS=3
ZOOTOPIA_AUTH_SIGNUP_IP_MAX_ATTEMPTS=15

# ---------------------------------------
# Session, active capacity, and credits
# ---------------------------------------
# Auth.js session TTL (seconds) for all authenticated identities.
# Default 3600, clamped to 60..604800 (7 days).
# Independent from active session lease minutes below.
ZOOTOPIA_SESSION_TTL_SECONDS=3600

# Active normal-user capacity governance (server-authoritative).
# limit: default 3, clamped to 1..100
# session minutes: default 15, clamped to 1..1440
# exempt emails: CSV/newline/semicolon accepted; malformed entries ignored.
# Note: elmahdyabdulla208@gmail.com is always injected as exempt by code.
ZOOTOPIA_ACTIVE_NORMAL_USER_LIMIT=3
ZOOTOPIA_ACTIVE_NORMAL_USER_SESSION_MINUTES=15
ZOOTOPIA_ACTIVE_NORMAL_USER_EXEMPT_EMAILS=elmahdyabdulla208@gmail.com

# Platform-wide daily usage cap (non-exempt users).
# default 33, clamped to 1..10000
ZOOTOPIA_PLATFORM_GLOBAL_DAILY_CREDIT_LIMIT=33

# Default daily assessment credits per user.
# default 3, clamped to 1..1000
ZOOTOPIA_DEFAULT_DAILY_ASSESSMENT_CREDITS=3

# Renewal window in UTC hours for daily credit windows.
# default 24, clamped to 1..168
ZOOTOPIA_ASSESSMENT_CREDIT_RENEWAL_WINDOW_HOURS=24

# -----------------------------------------
# Password gates (normal users only)
# -----------------------------------------
# Prompt lock is active only when password is non-empty and enabled flag is not false.
# Boolean parser for flags:
# - true: 1, true, yes, on
# - false: 0, false, no, off
# Password matching trims whitespace and tolerates one wrapping quote pair.
ZOOTOPIA_ASSESSMENT_PROMPT_LOCK_ENABLED=true
ZOOTOPIA_ASSESSMENT_PROMPT_UNLOCK_PASSWORD=

# Credits page lock uses the same semantics.
ZOOTOPIA_GLOBAL_CREDIT_PAGE_LOCK_ENABLED=true
ZOOTOPIA_GLOBAL_CREDIT_PAGE_PASSWORD=

# -----------------------------------------
# Email verification resend governance
# -----------------------------------------
# Canonical keys (preferred):
# mode: provider | disabled (default provider)
# cooldown seconds: default 30, clamped to 0..1800
# max attempts: clamped to 1..500
# window minutes: default 60, clamped to 1..1440
ZOOTOPIA_EMAIL_VERIFICATION_RESEND_MODE=provider
ZOOTOPIA_EMAIL_VERIFICATION_COOLDOWN_SECONDS=30
ZOOTOPIA_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
ZOOTOPIA_EMAIL_VERIFICATION_WINDOW_MINUTES=60
ZOOTOPIA_EMAIL_VERIFICATION_IP_MAX_ATTEMPTS=20
ZOOTOPIA_EMAIL_VERIFICATION_IP_WINDOW_MINUTES=60

# Keep stable after first production rollout; rotating changes hash lookup keys.
ZOOTOPIA_EMAIL_VERIFICATION_HASH_SALT=

# Compatibility aliases still accepted (prefer canonical keys above).
# ZOOTOPIA_VERIFICATION_RESEND_MODE=provider
# ZOOTOPIA_VERIFICATION_RESEND_COOLDOWN_SECONDS=30
# ZOOTOPIA_VERIFICATION_RESEND_ACCOUNT_MAX_ATTEMPTS=5
# ZOOTOPIA_VERIFICATION_RESEND_ACCOUNT_WINDOW_SECONDS=3600
# ZOOTOPIA_VERIFICATION_RESEND_IP_MAX_ATTEMPTS=20
# ZOOTOPIA_VERIFICATION_RESEND_IP_WINDOW_SECONDS=3600
# ZOOTOPIA_VERIFICATION_RESEND_HASH_SALT=

# Password security event hash salt (preferred key).
# Fallback chain in code: ZOOTOPIA_PASSWORD_SECURITY_HASH_SALT -> ZOOTOPIA_EMAIL_VERIFICATION_HASH_SALT
ZOOTOPIA_PASSWORD_SECURITY_HASH_SALT=

# ----------------------------
# Storage retention policy
# ----------------------------
# Per-scope minutes must be non-negative integers.
# Defaults:
# - uploads: 15
# - results: 1440 (1 day)
# - exports: 15
ZOOTOPIA_UPLOAD_RETENTION_MINUTES=15
ZOOTOPIA_RESULT_RETENTION_MINUTES=1440
ZOOTOPIA_EXPORT_RETENTION_MINUTES=15

# Mode per scope:
# - expiry (default): compute/enforce expiresAt
# - none: disable automatic expiry for that scope
ZOOTOPIA_UPLOAD_RETENTION_MODE=expiry
ZOOTOPIA_RESULT_RETENTION_MODE=expiry
ZOOTOPIA_EXPORT_RETENTION_MODE=expiry

# Legacy global fallback (only used when per-scope minutes are missing).
# ZOOTOPIA_STORAGE_RETENTION_DAYS=3
# ZOOTOPIA_STORAGE_RETENTION_HOURS=0
# ZOOTOPIA_STORAGE_RETENTION_MODE=expiry

# ----------------------------
# Maintenance and defaults
# ----------------------------
# Maintenance mode true values: 1, true, yes, on
ZOOTOPIA_MAINTENANCE_MODE_ENABLED=false

# Secret for /api/internal/maintenance/expired-uploads bearer auth.
ZOOTOPIA_MAINTENANCE_SECRET=

# Initial theme when no cookie is present.
# resolveInitialThemeMode accepts only "light"; everything else falls back to "dark".
ZOOTOPIA_DEFAULT_THEME_MODE=dark

# Initial language when no cookie is present.
# resolveInitialLocale accepts only "ar"; everything else falls back to "en".
ZOOTOPIA_DEFAULT_LANGUAGE=en

# Adapter debug logging gate (zootopia-postgres-adapter).
# true values: 1, true, yes
ZOOTOPIA_DEBUG=false

# ----------------------------
# AI provider runtime
# ----------------------------
# At least one provider key is required for generation.
GOOGLE_AI_API_KEY=
DASHSCOPE_API_KEY=

# DashScope-compatible base URL (canonical key).
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1

# Legacy DashScope base URL aliases (fallback chain still supported).
# DASHSCOPE_COMPATIBLE_BASE_URL=
# ALIBABA_MODEL_STUDIO_BASE_URL=

# Server-authoritative default model ids by tool scope.
# Value must be valid for that tool or runtime falls back to built-in default.
ZOOTOPIA_DEFAULT_MODEL_ASSESSMENT=gemini-2.5-flash-lite
ZOOTOPIA_DEFAULT_MODEL_INFOGRAPHIC=google-balanced

# Optional provider model overrides used by model descriptors.
# GOOGLE_AI_MODEL=
# GOOGLE_AI_ADVANCED_MODEL=
# QWEN_MODEL=

# ----------------------------
# Contact relay runtime
# ----------------------------
# /api/contact requires all of these to be set.
# SMTP_PORT must be a positive integer.
# SMTP_SECURE true values: 1, true, yes, on
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_FORM_TO=

# ----------------------------
# Local PDF executable overrides
# ----------------------------
ASSESSMENT_PDF_BROWSER_EXECUTABLE_PATH=
PUPPETEER_EXECUTABLE_PATH=

# --------------------------------------------------
# Legacy Firebase script compatibility (optional)
# --------------------------------------------------
# Not used by the current Supabase runtime, but kept for migration and historical scripts.
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
